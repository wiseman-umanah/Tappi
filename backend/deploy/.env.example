# Copy to .env on the server (never commit it). Generate each secret with: openssl rand -hex 32

# The API's public address; point its DNS A record at this server first. The app's
# EXPO_PUBLIC_API_URL (mobile/eas.json) is https://<this>.
TAPPI_DOMAIN=api.example.com

POSTGRES_PASSWORD=
ENGINE_DB_PASSWORD=
API_DB_PASSWORD=
# Shared secret between the API and the engine.
ENGINE_TOKEN=
# Peppers login-code and session hashes. Changing it signs everyone out.
SESSION_SECRET=

# true = /api/auth/code returns the login code so the app fills it in (testers only: anyone could
# sign in as anyone). Keep false once real email sending exists.
TAPPI_AUTO_CODE=true

# The web version of the app (mobile: pnpm build:web), as a JSON list of its https addresses, e.g.
# ["https://tappi-app.pages.dev"]. Empty = browsers can't call the API (the phone app doesn't need it).
CORS_ORIGINS=[]

# TESTING ONLY. true = give testers money with: docker compose exec api tappi-fund @user NGN 50000
# (while Paga and Bitnob can't fund sandbox accounts). Before real money: false + a fresh database.
ENGINE_SANDBOX=false
# Test swap rates while ENGINE_SANDBOX=true (swaps are filled in Tappi's ledger, not at Bitnob).
TEST_NGN_PER_USD=1569
TEST_USD_PER_BTC=68000

GROQ_API_KEY=
INTRON_API_KEY=

# Paga (NGN account numbers, bank withdrawals). sandbox or live. Payouts need this server's IP
# allow-listed by Paga. Leave the keys empty to run without Paga.
PAGA_ENV=sandbox
PAGA_PUBLIC_KEY=
PAGA_SECRET_KEY=
PAGA_HASH_KEY=

# Bitnob (USDT, USDC, Bitcoin). In Bitnob's dashboard set the webhook URL to
# https://<TAPPI_DOMAIN>/api/webhooks/bitnob/events. Leave empty to run without Bitnob.
BITNOB_CLIENT_ID=
BITNOB_CLIENT_SECRET=
BITNOB_WEBHOOK_SECRET=

# Ports Caddy listens on (80/443 on a real server).
# HTTP_PORT=80
# HTTPS_PORT=443

# USD card prices charged to users, in dollars. Leave empty for Bitnob's published fees ($1 to create;
# top-ups $1 below $100, 1% from $100). Change them when Bitnob's prices or your agreement change.
CARD_CREATION_FEE_USD=
CARD_TOPUP_FEE_USD=
CARD_TOPUP_FEE_PERCENT=
CARD_TOPUP_PERCENT_FROM_USD=
