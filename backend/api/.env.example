# Tappi API (what the phone app talks to). Copy to .env.
DATABASE_URL=postgresql+asyncpg://tappi:tappi@127.0.0.1:5433/tappi
# 32+ random characters: openssl rand -hex 32. Changing it signs everyone out.
SESSION_SECRET=
# The Rust engine, and the same ENGINE_TOKEN it was started with.
ENGINE_URL=http://127.0.0.1:8090
ENGINE_TOKEN=
# Test money (welcome grant, "Add money"). The engine needs ENGINE_SANDBOX=true too. Never in production.
SANDBOX=true
# While testing, /api/auth/code returns the code so the app fills it in. false = codes only in the log.
TAPPI_AUTO_CODE=true

# Tappi AI. Groq: Whisper, the chat model and Orpheus (English voice). https://console.groq.com
GROQ_API_KEY=
# Intron Sahara: African-language voices. Optional: without it replies are voiced in English (and Pidgin) by Orpheus.
INTRON_API_KEY=
# AI_MODEL=openai/gpt-oss-120b
# WHISPER_MODEL=whisper-large-v3
# TTS_MODEL=canopylabs/orpheus-v1-english
# TTS_TIMEOUT_S=12

# Where the API listens. 0.0.0.0 to reach it from a phone on the same Wi-Fi during development.
# API_HOST=127.0.0.1
# API_PORT=8080
# Browser origins allowed to call the API, as JSON: the Expo web build in development.
# CORS_ORIGINS=["http://localhost:8081"]
