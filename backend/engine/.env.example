# Tappi engine. Never exposed publicly: only the Tappi API calls it, over the private network.
DATABASE_URL=postgres://tappi:tappi@127.0.0.1:5433/tappi
# Shared secret the API sends as `Authorization: Bearer …`. At least 32 characters: openssl rand -hex 32
ENGINE_TOKEN=
ENGINE_ADDR=127.0.0.1:8090
# Automated tests only: true lets /v1/sandbox/credit and /debit mint and burn money. Real money
# (including the providers' sandbox money) arrives through Paga and Bitnob. Keep this false.
ENGINE_SANDBOX=false
RUST_LOG=info

# Our public https address: providers post webhooks to {PUBLIC_URL}/api/webhooks/<provider>/… (the
# API forwards them here). In development, your ngrok address.
# PUBLIC_URL=https://your-name.ngrok-free.app

# Paga (dashboard → Developer Tools → API Keys). All three or none. Sandbox keys come from the
# separate sandbox account at beta-business.paga.com. Payouts need this server's IP allow-listed by Paga.
# PAGA_ENV=sandbox
# PAGA_PUBLIC_KEY=
# PAGA_SECRET_KEY=
# PAGA_HASH_KEY=

# Bitnob (dashboard → API keys: client ID + client secret; Settings → Webhooks: webhook secret, with
# the webhook URL set to {PUBLIC_URL}/api/webhooks/bitnob/events). All three or none. Sandbox and
# live use the same host; the keys decide which.
# BITNOB_CLIENT_ID=
# BITNOB_CLIENT_SECRET=
# BITNOB_WEBHOOK_SECRET=

# USD card prices charged to users, in dollars (defaults: Bitnob's published fees). Change these when
# Bitnob's prices or your agreement change; the app shows whatever is set here.
# CARD_CREATION_FEE_USD=1
# CARD_TOPUP_FEE_USD=1
# CARD_TOPUP_FEE_PERCENT=1
# CARD_TOPUP_PERCENT_FROM_USD=100
