# Build-time: public URL of the site, used for canonical links, Open Graph, robots.txt and sitemap.xml.
# On Cloudflare Pages, set it under Settings → Variables and Secrets (Production).
NEXT_PUBLIC_SITE_URL=https://tappi.app

# Runtime (Cloudflare Pages Function functions/api/waitlist.ts): where "Join the List" sign-ups are
# POSTed as JSON { email, intent, source }. Unset: the form answers "Sign-ups are not open yet".
WAITLIST_WEBHOOK_URL=
