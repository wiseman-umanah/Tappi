# Copy to .env.local (`pnpm secrets` does it for you). Server-only: the Tappi API routes and scripts
# read these; none of them reach the phone app. Everything runs on Stellar TESTNET.

# ─── Database ───────────────────────────────────────────────────────────
# Leave empty for local mode: an embedded Postgres (PGlite) stored in .data/pglite, migrated on
# startup inside `pnpm start`. Nothing to install.
# For hosted Postgres (Neon), paste the connection string, then `pnpm db:migrate`.
DATABASE_URL=

# ─── Secrets ────────────────────────────────────────────────────────────
# 32 random bytes, base64. Generated by: pnpm secrets
# Encrypts every wallet secret key at rest (AES-256-GCM). Losing it = losing every wallet.
WALLET_ENCRYPTION_KEY=
# Peppers login-code and session hashes.
SESSION_SECRET=

# ─── Stellar (testnet) ──────────────────────────────────────────────────
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
# Circle testnet USDC issuer — check https://developers.circle.com/stablecoins/usdc-contract-addresses
USDC_ISSUER=GBBD47IF6LWK7P7MDEVSCWR7DPUWV3NY3DTQEVFL4NAT4AQH3ZLLFLA5
# Rate the testnet market maker quotes for swaps (NGN per 1 USDC).
NGN_PER_USDC=1569

# Created by: pnpm stellar:bootstrap
# Treasury: sponsors account reserves, pays every fee (fee-bump), funds the test faucets.
TREASURY_SECRET=
# Issues Tappi's test naira (asset code NGN).
NGN_ISSUER_SECRET=
# Keeps NGN/USDC offers on the testnet exchange so swaps have liquidity.
MARKET_MAKER_SECRET=

# Days a deleted account can be restored by signing in again (default 30). Fractions shorten it
# for testing, e.g. 0.001 ≈ 90 seconds.
# ACCOUNT_RESTORE_DAYS=30

# ─── Tappi AI (centre button: chat + voice) ─────────────────────────────
# Groq: Whisper speech-to-text, the chat model, Orpheus English voice. https://console.groq.com
GROQ_API_KEY=
# Intron Sahara: African-language voices (Pidgin, Yoruba, Hausa, Igbo…). Optional: without it
# replies are voiced in English by Orpheus.
INTRON_API_KEY=
# INTRON_BASE_URL=https://infer.voice.intron.io
# AI_MODEL=openai/gpt-oss-120b
# WHISPER_MODEL=whisper-large-v3
# TTS_MODEL=canopylabs/orpheus-v1-english
# Seconds each voice provider gets before the reply is shown without audio (Sahara is slow).
# TTS_TIMEOUT_S=12
