# Copy to .env.local. The app has no secrets: the server side is backend/ (engine + API).

# Where the Tappi API is. Leave unset in development: the app then calls port 8080 on the laptop
# running Metro (start the API with API_HOST=0.0.0.0 so the phone can reach it). Set it for builds,
# for `pnpm start:remote` (tunnels can't reach your laptop's API), or to use a hosted API.
# EXPO_PUBLIC_API_URL=https://api.example.com
