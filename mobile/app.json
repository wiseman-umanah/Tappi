{
  "expo": {
    "name": "Tappi",
    "slug": "tappi",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icons/icon.png",
    "scheme": "tappi",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#191919",
    "ios": {
      "bundleIdentifier": "com.tappi.app",
      "supportsTablet": false
    },
    "android": {
      "package": "com.tappi.app",
      "adaptiveIcon": {
        "backgroundColor": "#3B82F6",
        "foregroundImage": "./assets/icons/adaptive-foreground.png",
        "monochromeImage": "./assets/icons/adaptive-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.CAMERA",
        "android.permission.NFC"
      ]
    },
    "web": {
      "favicon": "./assets/icons/favicon.png",
      "output": "single"
    },
    "plugins": [
      [
        "expo-router",
        {
          "asyncRoutes": {
            "web": false
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#191919",
          "image": "./assets/icons/splash-icon.png",
          "imageWidth": 120
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Tappi uses the microphone when you talk to Tappi AI."
        }
      ],
      "expo-secure-store",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow Tappi to use Face ID to unlock payments."
        }
      ],
      "expo-asset",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Tappi to use the camera to scan payment QR codes.",
          "microphonePermission": "Tappi uses the microphone when you talk to Tappi AI.",
          "recordAudioAndroid": false
        }
      ],
      [
        "react-native-nfc-manager",
        {
          "nfcPermission": "Tappi uses NFC to take card and phone taps, and to tap to pay.",
          "includeNdefEntitlement": true
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "buildArchs": [
              "arm64-v8a",
              "armeabi-v7a"
            ],
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "useLegacyPackaging": true
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": false
        }
      },
      "eas": {
        "projectId": "e185c6f9-8ab6-4dd2-b01a-fd20a9a64d18"
      }
    }
  }
}
